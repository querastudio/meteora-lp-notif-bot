# Salin file ini ke .env lalu isi dengan token & chat id Anda.
# JANGAN PERNAH commit .env yang sudah terisi ke git.

# Didapat dari @BotFather di Telegram setelah /newbot
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Chat ID tujuan notifikasi (chat id Anda sendiri). Bisa didapat lewat
# bot seperti @userinfobot, atau lewat endpoint getUpdates bot Anda sendiri.
TELEGRAM_CHAT_ID=123456789
